# ── Mobile Application Download URLs ──────────────────────────────────────────
# Defaults point to the latest GitHub Release for each app.
# Override here to point to a staging build or a specific release version.
# STUDENT_APK_URL=https://github.com/Emran025/shafeea_student/releases/latest/download/shafeea-student.apk
# TEACH_APK_URL=https://github.com/Emran025/shafeea_teach/releases/latest/download/shafeea-teach.apk

# ── Build API — RSA Signature Authentication ───────────────────────────────────
# Public key used to verify signed requests from GitHub Actions (Build API).
# The matching private key is stored in GitHub Secrets as BUILD_API_PRIVATE_KEY.
#
# Generate a keypair (one-time setup):
#   openssl genrsa -out build_api_private.pem 4096
#   openssl rsa -in build_api_private.pem -pubout -out build_api_public.pem
#
# Paste the FULL content of build_api_public.pem here (including header/footer).
BUILD_API_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
PASTE_YOUR_PUBLIC_KEY_HERE
-----END PUBLIC KEY-----"

# ── GitHub Integration ─────────────────────────────────────────────────────────
# Personal Access Token with repo scope — used by the admin dashboard to
# trigger repository_dispatch events to both application repositories simultaneously.
# Scope required: repo (or workflow).
GITHUB_DISPATCH_TOKEN=
GITHUB_OWNER=Emran025
GITHUB_STUDENT_REPO=shafeea_student
GITHUB_TEACH_REPO=shafeea_teach
