                {
                    "id": "acb00002-0000-0000-0000-000000000003",
                    "type": "headline",
                    "position": 2,
                    "weight": 9,
                    "featured": false,
                    "content": {
                        "en": {
                            "text": "Individual financial activity lives in scattered tools."
                        },
                        "ar": {
                            "text": "Individual financial activity lives in scattered tools."
                        }
                    }
                },
                {
                    "id": "acb00003-0000-0000-0000-000000000003",
                    "type": "rich_text",
                    "position": 3,
                    "weight": 5,
                    "featured": false,
                    "content": {
                        "en": {
                            "content": {
                                "type": "doc",
                                "content": [
                                    {
                                        "type": "paragraph",
                                        "content": [
                                            {
                                                "type": "text",
                                                "text": "Freelancers track income in a spreadsheet. Invoices go out from email. Expenses are photographed and forgotten. Tax season is a reconciliation nightmare. Small business owners face the same problem — the tools exist, but they don't connect, and none of them are built for someone who needs to run a business, not manage software."
                                            }
                                        ]
                                    }
                                ]
                            }
                        },
                        "ar": {
                            "content": {
                                "type": "doc",
                                "content": [
                                    {
                                        "type": "paragraph",
                                        "content": [
                                            {
                                                "type": "text",
                                                "text": "Freelancers track income in a spreadsheet. Invoices go out from email. Expenses are photographed and forgotten. Tax season is a reconciliation nightmare. Small business owners face the same problem — the tools exist, but they don't connect, and none of them are built for someone who needs to run a business, not manage software."
                                            }
                                        ]
                                    }
                                ]
                            }
                        }
                    }
                }
            ]
