    {
      "id": "i0400s03-0000-0000-0000-000000000001",
      "type": "problem_statement",
      "name": "The Challenge",
      "anchor_id": "industries-hospitality-problem",
      "position": 3,
      "group": "below-fold",
      "required_block_types": [],
      "blocks": [
        {
          "id": "i0400b03-0001-0000-0000-000000000001",
          "type": "label",
          "position": 1,
          "weight": 5,
          "featured": false,
          "content": {
            "en": {
              "text": "The scaling challenge"
            },
            "ar": {
              "text": "تحدي التوسّع"
            }
          }
        },
        {
          "id": "i0400b03-0002-0000-0000-000000000001",
          "type": "headline",
          "position": 2,
          "weight": 10,
          "featured": true,
          "content": {
            "en": {
              "text": "Multiple venues require financial infrastructure most hospitality businesses lack."
            },
            "ar": {
              "text": "المنشآت المتعددة تستلزم بنية تحتية مالية تفتقر إليها معظم أعمال الضيافة."
            }
          }
        },
        {
          "id": "i0400b03-0003-0000-0000-000000000001",
          "type": "subheadline",
          "position": 3,
          "weight": 7,
          "featured": false,
          "content": {
            "en": {
              "text": "Hospitality businesses opening a second location find that their informal financial processes cannot accommodate two revenue streams, two supplier relationships, and two staff payrolls."
            },
            "ar": {
              "text": "تجد أعمال الضيافة التي تفتح موقعاً ثانياً أن عملياتها المالية غير الرسمية لا تستوعب دفقتين للإيراد وعلاقتين مع الموردين وكشفي رواتب لموظفين."
            }
          }
        },
        {
          "id": "i0400b03-0004-0000-0000-000000000001",
          "type": "feature_item",
          "position": 4,
          "weight": 7,
          "featured": false,
          "content": {
            "en": {
              "label": "Consolidated revenue gap",
              "text": "Revenue from different venues and booking channels cannot be combined without manual aggregation."
            },
            "ar": {
              "text": "إيراد المنشآت المختلفة وقنوات الحجز لا يمكن دمجه دون تجميع يدوي.",
              "label": "فجوة الإيراد الموحّد"
            }
          }
        },
        {
          "id": "i0400b03-0005-0000-0000-000000000001",
          "type": "feature_item",
          "position": 5,
          "weight": 7,
          "featured": false,
          "content": {
            "en": {
              "label": "Rota-to-payroll errors",
              "text": "Staff scheduled hours and actual hours worked are tracked separately, creating payroll disputes."
            },
            "ar": {
              "text": "ساعات الموظفين المجدولة والفعلية تُتابَع بشكل منفصل، مما يُفضي إلى نزاعات كشوف الرواتب.",
              "label": "أخطاء الجداول إلى كشوف الرواتب"
            }
          }
        },
        {
          "id": "i0400b03-0006-0000-0000-000000000001",
          "type": "feature_item",
          "position": 6,
          "weight": 7,
          "featured": false,
          "content": {
            "en": {
              "label": "Kitchen stock accuracy",
              "text": "Kitchen consumption is not tracked against purchasing, making real food cost calculations impossible."
            },
            "ar": {
              "text": "استهلاك المطبخ لا يُتابَع مقابل المشتريات، مما يجعل احتساب تكلفة الطعام الفعلية مستحيلاً.",
              "label": "دقة مخزون المطبخ"
            }
          }
        }
      ]
    },
