        },
        {
          "id": "i0400b07-0003-0000-0000-000000000001",
          "type": "use_case_card",
          "position": 3,
          "weight": 7,
          "featured": false,
          "content": {
            "en": {
              "headline": "A 4-venue restaurant group consolidates revenue.",
              "scenario_narrative": "A restaurant group with 4 venues connected all POS systems to ACCSYSTEM. For the first time, the owner could see consolidated daily revenue, labour cost percentage, and F&B cost in a single morning report.",
              "tags": [
                "Restaurant Group",
                "Revenue Consolidation"
              ]
            },
            "ar": {
              "headline": "مجموعة مطاعم بـ 4 منشآت توحّد الإيراد.",
              "scenario_narrative": "مجموعة مطاعم بـ 4 منشآت ربطت جميع أنظمة نقطة البيع بـ ACCSYSTEM. للمرة الأولى، تمكّن المالك من رؤية الإيراد اليومي الموحّد ونسبة تكلفة العمالة وتكلفة الأغذية والمشروبات في تقرير صباحي واحد.",
              "tags": [
                "Restaurant Group",
                "Revenue Consolidation"
              ]
            }
          }
        },
        {
          "id": "i0400b07-0004-0000-0000-000000000001",
          "type": "use_case_card",
          "position": 4,
          "weight": 7,
          "featured": false,
          "content": {
            "en": {
              "headline": "A hotel group reduces labour cost overspend.",
              "scenario_narrative": "A 3-property hotel group deployed ACCSYSTEM's labour cost dashboard. Venue managers now see labour cost versus budget in real time, reducing monthly overtime spend by £22,000 across all properties.",
              "tags": [
                "Hotel Group",
                "Labour Cost"
              ]
            },
