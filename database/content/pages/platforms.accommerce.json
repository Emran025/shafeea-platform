            "blocks": [
                {
                    "id": "acb00001-0000-0000-0000-000000000002",
                    "type": "label",
                    "position": 1,
                    "weight": 5,
                    "featured": false,
                    "content": {
                        "en": {
                            "text": "The Problem"
                        },
                        "ar": {
                            "text": "المشكلة"
                        }
                    }
                },
                {
                    "id": "acb00002-0000-0000-0000-000000000002",
                    "type": "headline",
                    "position": 2,
                    "weight": 9,
                    "featured": false,
                    "content": {
                        "en": {
                            "text": "Commerce platforms show what you have — not what you actually have."
                        },
                        "ar": {
                            "text": "Commerce platforms show what you have — not what you actually have."
                        }
                    }
                },
                {
                    "id": "acb00003-0000-0000-0000-000000000002",
                    "type": "rich_text",
                    "position": 3,
                    "weight": 5,
                    "featured": false,
                    "content": {
                        "en": {
                            "content": {
                                "type": "doc",
                                "content": [
                                    {
                                        "type": "paragraph",
                                        "content": [
                                            {
                                                "type": "text",
                                                "text": "Stock counts are updated manually. Orders create reconciliation lag. Product availability is an approximation. Customers see what the system was told to show — not the live operational truth. The cost is overselling, underselling, and customer trust eroded one delayed order at a time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        },
                        "ar": {
                            "content": {
                                "type": "doc",
                                "content": [
                                    {
                                        "type": "paragraph",
                                        "content": [
                                            {
                                                "type": "text",
                                                "text": "Stock counts are updated manually. Orders create reconciliation lag. Product availability is an approximation. Customers see what the system was told to show — not the live operational truth. The cost is overselling, underselling, and customer trust eroded one delayed order at a time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        }
                    }
                }
            ]
        },
