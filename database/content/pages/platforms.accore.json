            }
          }
        },
        {
          "id": "acbp0002-0000-0000-0000-000000000001",
          "type": "headline",
          "position": 2,
          "weight": 9,
          "featured": false,
          "content": {
            "en": {
              "text": "Enterprise operations are fragmented by design."
            },
            "ar": {
              "text": "Enterprise operations are fragmented by design."
            }
          }
        },
        {
          "id": "acbp0003-0000-0000-0000-000000000001",
          "type": "rich_text",
          "position": 3,
          "weight": 5,
          "featured": false,
          "content": {
            "en": {
              "content": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Inventory lives in one system. Procurement in another. Supplier relationships in a spreadsheet. Financial reporting requires a full day of reconciliation. The data is there — but the system is not."
                      }
                    ]
                  },
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Enterprise businesses lose significant operational capacity not because they lack data — but because their data does not flow coherently between the functions that need it."
                      }
                    ]
                  }
                ]
              }
            },
            "ar": {
              "content": {
                "type": "doc",
                "content": [
