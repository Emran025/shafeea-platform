          "id": "i0100b04-0002-0000-0000-000000000001",
          "type": "headline",
          "position": 2,
          "weight": 10,
          "featured": true,
          "content": {
            "en": {
              "text": "Fragmented data stalls clinical growth."
            },
            "ar": {
              "text": "البيانات المجزّأة تُعيق النمو السريري."
            }
          }
        },
        {
          "id": "i0100b04-0003-0000-0000-000000000001",
          "type": "subheadline",
          "position": 3,
          "weight": 7,
          "featured": false,
          "content": {
            "en": {
              "text": "When your clinic grows beyond 5 staff, manual reconciliation between billing and clinical records becomes a full-time job."
            },
            "ar": {
              "text": "حين يتخطى عيادتك عتبة 5 موظفين، يصبح التسوية اليدوية بين سجلات الفوترة والسجلات السريرية وظيفة بدوام كامل."
            }
          }
        },
        {
          "id": "i0100b04-0004-0000-0000-000000000001",
          "type": "feature_item",
          "position": 4,
          "weight": 7,
          "featured": false,
          "content": {
            "en": {
              "label": "Reconciliation gaps",
              "text": "Manual invoice-to-payment reconciliation across disconnected patient records."
            },
            "ar": {
              "text": "تسوية يدوية من الفاتورة إلى الدفع عبر سجلات مرضى منفصلة.",
              "label": "فجوات التسوية"
            }
          }
        },
        {
          "id": "i0100b04-0005-0000-0000-000000000001",
          "type": "feature_item",
          "position": 5,
          "weight": 7,
          "featured": false,
          "content": {
            "en": {
              "label": "Inventory leakage",
              "text": "Pharmacy overstock and expiry waste due to untracked consumable usage."
            },
            "ar": {
              "text": "مخزون صيدلية زائد وهدر انتهاء صلاحية بسبب استهلاك مستهلكات غير مُتتبَّع.",
              "label": "تسرّب المخزون"
            }
          }
        },
        {
          "id": "i0100b04-0006-0000-0000-000000000001",
          "type": "feature_item",
          "position": 6,
          "weight": 7,
          "featured": false,
          "content": {
            "en": {
              "label": "Payroll friction",
              "text": "Inaccurate clinical staff payroll caused by manual shift tracking across multiple facilities."
            },
            "ar": {
              "text": "كشف رواتب موظفين سريريين غير دقيق بسبب التتبّع اليدوي للورديات عبر منشآت متعددة.",
              "label": "احتكاك كشوف الرواتب"
            }
          }
        }
