                {
                    "id": "33333333-0000-0000-0000-000000000205",
                    "type": "form_definition",
                    "position": 5,
                    "weight": 10,
                    "featured": true,
                    "content": {
                        "en": {
                            "form_title": "Send an Inquiry",
                            "submit_label": "Submit Message",
                            "success_message": "Thank you for contacting {{school.name}}. Our team will respond to your inquiry shortly.",
                            "fields": [
                                {
                                    "field_name": "parent_name",
                                    "label": "Full Name",
                                    "field_type": "text",
                                    "is_required": true,
                                    "placeholder": "e.g. Abdullah Ahmed"
                                },
                                {
                                    "field_name": "email",
                                    "label": "Email Address",
                                    "field_type": "email",
                                    "is_required": true,
                                    "placeholder": "name@example.com"
                                },
                                {
                                    "field_name": "phone",
                                    "label": "Phone Number",
                                    "field_type": "phone",
                                    "is_required": false,
                                    "placeholder": "+966 5x xxx xxxx"
                                },
                                {
                                    "field_name": "inquiry_type",
                                    "label": "Inquiry Type",
                                    "field_type": "select",
                                    "is_required": true,
                                    "options": [
                                        "General Inquiry",
                                        "Admissions & Registration",
                                        "Academic & Curriculum",
                                        "Platform & Technical Support"
                                    ]
                                },
                                {
                                    "field_name": "message",
                                    "label": "Your Message",
                                    "field_type": "textarea",
                                    "is_required": true,
                                    "placeholder": "How can we help you today?"
                                }
                            ]
                        },
                        "ar": {
                            "form_title": "إرسال استفسار",
                            "submit_label": "إرسال الرسالة",
                            "success_message": "شكراً لتواصلك مع {{school.name}}. سيرد فريقنا على استفسارك في أقرب وقت.",
                            "fields": [
                                {
                                    "field_name": "parent_name",
                                    "label": "الاسم الكامل",
                                    "field_type": "text",
                                    "is_required": true,
                                    "placeholder": "مثال: عبدالله أحمد"
                                },
                                {
                                    "field_name": "email",
                                    "label": "البريد الإلكتروني",
                                    "field_type": "email",
                                    "is_required": true,
                                    "placeholder": "name@example.com"
                                },
                                {
                                    "field_name": "phone",
                                    "label": "رقم الهاتف",
                                    "field_type": "phone",
                                    "is_required": false,
                                    "placeholder": "+966 5x xxx xxxx"
                                },
                                {
                                    "field_name": "inquiry_type",
                                    "label": "نوع الاستفسار",
                                    "field_type": "select",
                                    "is_required": true,
                                    "options": [
                                        "استفسار عام",
                                        "القبول والتسجيل",
                                        "الشؤون الأكاديمية والمناهج",
                                        "الدعم الفني والمنصة"
                                    ]
                                },
                                {
                                    "field_name": "message",
                                    "label": "رسالتك",
                                    "field_type": "textarea",
                                    "is_required": true,
                                    "placeholder": "كيف يمكننا مساعدتك اليوم؟"
                                }
                            ]
                        }
                    }
                }
            ]
