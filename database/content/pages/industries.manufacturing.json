          "type": "feature_item",
          "position": 4,
          "weight": 7,
          "featured": false,
          "content": {
            "en": {
              "label": "Consolidated cost reporting delay",
              "text": "Group production cost reports are compiled manually from individual plant data, arriving weeks after the period."
            },
            "ar": {
              "text": "Group production cost reports are compiled manually from individual plant data, arriving weeks after the period.",
              "label": "Consolidated cost reporting delay"
            }
