    {
      "id": "00300003-0000-0000-0000-000000000001",
      "type": "problem_statement",
      "name": "The Challenge",
      "anchor_id": "industries-retail-problem",
      "position": 3,
      "group": "below-fold",
      "required_block_types": [],
      "blocks": [
        {
          "id": "00300b03-0001-0000-0000-000000000001",
          "type": "label",
          "position": 1,
          "weight": 5,
          "featured": false,
          "content": {
            "en": {
              "text": "The growth ceiling"
            },
            "ar": {
              "text": "سقف النمو"
            }
          }
        },
        {
          "id": "00300b03-0002-0000-0000-000000000001",
          "type": "headline",
          "position": 2,
          "weight": 10,
          "featured": true,
          "content": {
            "en": {
              "text": "Multi-location retail exposes process failures."
            },
            "ar": {
              "text": "تجزئة متعددة المواقع تكشف إخفاقات العمليات."
            }
          }
        },
        {
          "id": "00300b03-0003-0000-0000-000000000001",
          "type": "subheadline",
          "position": 3,
          "weight": 7,
          "featured": false,
          "content": {
            "en": {
              "text": "Retail businesses opening a second or third location find that manual stock and accounts processes collapse without dedicated finance staff."
            },
            "ar": {
              "text": "تجد الشركات التجزئية التي تفتح موقعاً ثانياً أو ثالثاً أن عمليات المخزون والحسابات اليدوية تنهار دون موظفين ماليين متخصصين."
            }
          }
        },
        {
          "id": "00300b03-0004-0000-0000-000000000001",
          "type": "feature_item",
          "position": 4,
          "weight": 7,
          "featured": false,
          "content": {
            "en": {
              "label": "Stock transfer errors",
              "text": "Inter-location stock movements are tracked manually, creating discrepancies that take days to resolve."
            },
            "ar": {
              "text": "حركات المخزون بين المواقع تُتابَع يدوياً، مما يُفضي إلى تناقضات تستغرق أياماً لحلّها.",
              "label": "أخطاء نقل المخزون"
            }
          }
        },
        {
          "id": "00300b03-0005-0000-0000-000000000001",
          "type": "feature_item",
          "position": 5,
          "weight": 7,
          "featured": false,
          "content": {
            "en": {
              "label": "Margin erosion",
              "text": "Promotions and markdowns are applied inconsistently across locations, eroding margin without visibility."
            },
            "ar": {
              "text": "العروض والتخفيضات تُطبَّق بشكل غير متسق عبر المواقع، مما يؤكّل الهامش دون رؤية.",
              "label": "تآكل الهامش"
            }
          }
        },
        {
          "id": "00300b03-0006-0000-0000-000000000001",
          "type": "feature_item",
          "position": 6,
          "weight": 7,
          "featured": false,
          "content": {
            "en": {
              "label": "Supplier consolidation",
              "text": "Each location has separate supplier accounts, forfeiting group pricing that would materially improve margins."
            },
            "ar": {
              "text": "كل موقع لديه حسابات موردين منفصلة، متنازلاً عن أسعار المجموعة التي ستُحسّن الهوامش بشكل ملموس.",
              "label": "توحيد الموردين"
            }
          }
        }
      ]
    },
