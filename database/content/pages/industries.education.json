    {
      "id": "00200003-0000-0000-0000-000000000001",
      "type": "problem_statement",
      "name": "The Challenge",
      "anchor_id": "industries-education-problem",
      "position": 3,
      "group": "below-fold",
      "required_block_types": [],
      "blocks": [
        {
          "id": "00200b03-0001-0000-0000-000000000001",
          "type": "label",
          "position": 1,
          "weight": 5,
          "featured": false,
          "content": {
            "en": {
              "text": "The enrolment growth problem"
            },
            "ar": {
              "text": "مشكلة نمو التسجيل"
            }
          }
        },
        {
          "id": "00200b03-0002-0000-0000-000000000001",
          "type": "headline",
          "position": 2,
          "weight": 10,
          "featured": true,
          "content": {
            "en": {
              "text": "Growing student numbers expose finance process gaps."
            },
            "ar": {
              "text": "أعداد الطلاب المتزايدة تكشف ثغرات العمليات المالية."
            }
          }
        },
        {
          "id": "00200b03-0003-0000-0000-000000000001",
          "type": "subheadline",
          "position": 3,
          "weight": 7,
          "featured": false,
          "content": {
            "en": {
              "text": "Independent schools with expanding enrolment find that manual fee collection and payroll processes cannot scale beyond 100 students without dedicated finance staff."
            },
            "ar": {
              "text": "تجد المدارس المستقلة ذات التسجيل المتوسّع أن عمليات تحصيل الرسوم وكشوف الرواتب اليدوية لا يمكنها التوسّع لما فوق 100 طالب دون موظفين ماليين متخصصين."
            }
          }
        },
        {
          "id": "00200b03-0004-0000-0000-000000000001",
          "type": "feature_item",
          "position": 4,
          "weight": 7,
          "featured": false,
          "content": {
            "en": {
              "label": "Fee arrears accumulation",
              "text": "Without automated dunning, tuition arrears build silently until they become irrecoverable."
            },
            "ar": {
              "text": "دون متابعة آلية، تتراكم متأخرات الرسوم الدراسية صامتةً حتى تُصبح غير قابلة للاسترداد.",
              "label": "تراكم متأخرات الرسوم"
            }
          }
        },
        {
          "id": "00200b03-0005-0000-0000-000000000001",
          "type": "feature_item",
          "position": 5,
          "weight": 7,
          "featured": false,
          "content": {
            "en": {
              "label": "Payroll complexity",
              "text": "Varying teacher contracts — full-time, part-time, and sessional — create payroll calculation errors."
            },
            "ar": {
              "text": "تعاقدات المعلمين المتنوعة — بدوام كامل وجزئي وبالجلسات — تخلق أخطاء في احتساب كشوف الرواتب.",
              "label": "تعقيد كشوف الرواتب"
            }
          }
        },
        {
          "id": "00200b03-0006-0000-0000-000000000001",
          "type": "feature_item",
          "position": 6,
          "weight": 7,
          "featured": false,
          "content": {
            "en": {
              "label": "Supplier reconciliation",
              "text": "Monthly reconciliation of textbook, equipment, and facility supplier invoices is done manually from email inboxes."
            },
            "ar": {
              "text": "تسوية فواتير موردي الكتب والمعدات والمرافق شهرياً تُجرى يدوياً من صناديق البريد الإلكتروني.",
              "label": "تسوية الموردين"
            }
          }
        }
      ]
    },
