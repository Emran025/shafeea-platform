        {
          "id": "00200b04-0004-0000-0000-000000000001",
          "type": "feature_item",
          "position": 4,
          "weight": 7,
          "featured": false,
          "content": {
            "en": {
              "label": "Automated Fee Collection",
              "text": "Tuition invoices issue automatically on schedule with payment reminders reducing arrears without staff intervention."
            },
            "ar": {
              "text": "تُصدَر فواتير الدراسة تلقائياً وفق الجدول مع تذكيرات دفع تُخفّض المتأخرات دون تدخل الموظفين.",
              "label": "التحصيل التلقائي للرسوم"
            }
          }
        },
        {
          "id": "00200b04-0005-0000-0000-000000000001",
          "type": "feature_item",
          "position": 5,
          "weight": 7,
          "featured": false,
          "content": {
            "en": {
              "label": "Grant Compliance Built-In",
              "text": "Restricted fund rules are enforced at transaction level, eliminating year-end compliance surprises."
            },
            "ar": {
              "text": "تُطبَّق قواعد الصناديق المقيّدة على مستوى المعاملة، مما يُلغي مفاجآت الامتثال في نهاية العام.",
              "label": "الامتثال للمنح مدمج"
            }
          }
        },
        {
          "id": "00200b04-0006-0000-0000-000000000001",
          "type": "feature_item",
          "position": 6,
          "weight": 7,
          "featured": false,
          "content": {
            "en": {
              "label": "Multi-Tier Fee Structures",
              "text": "Handle tuition, boarding, extracurricular, and transport fees on a single unified student account."
            },
            "ar": {
              "text": "أدر رسوم الدراسة والإقامة والأنشطة اللاصفية والمواصلات على حساب طالب موحّد واحد.",
              "label": "هياكل رسوم متعددة المستويات"
            }
          }
        },
        {
          "id": "00200b04-0007-0000-0000-000000000001",
          "type": "feature_item",
          "position": 7,
          "weight": 7,
          "featured": false,
          "content": {
            "en": {
              "label": "Academic Cycle Financial Planning",
              "text": "Budget and forecast aligned to academic year terms, intake periods, and examination cycles."
            },
            "ar": {
              "text": "ميزانية وتوقعات متوافقة مع فصول العام الدراسي وفترات القبول ودورات الامتحانات.",
              "label": "التخطيط المالي لدورة العام الدراسي"
            }
          }
        }
