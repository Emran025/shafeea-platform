          "content": {
            "en": {
              "content": {
                "type": "doc",
                "content": [
                  {
                    "type": "heading",
                    "attrs": {
                      "level": 2
                    },
                    "content": [
                      {
                        "type": "text",
                        "text": "Information We Collect"
                      }
                    ]
                  },
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "ACCSYSTEM collects information you provide directly when contacting us, including your name, email address, and the content of your message. We do not collect personal data through automated means beyond standard server logs."
                      }
                    ]
                  },
                  {
                    "type": "heading",
                    "attrs": {
                      "level": 2
                    },
                    "content": [
                      {
                        "type": "text",
                        "text": "How We Use Information"
                      }
                    ]
                  },
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Information you submit is used solely to respond to your inquiry. We do not sell, trade, or otherwise transfer personal information to third parties."
                      }
                    ]
                  },
                  {
                    "type": "heading",
                    "attrs": {
                      "level": 2
                    },
                    "content": [
                      {
                        "type": "text",
                        "text": "Data Retention"
                      }
                    ]
                  },
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "We retain contact submissions for a period sufficient to address your inquiry. Submissions are deleted upon request."
                      }
                    ]
                  },
                  {
                    "type": "heading",
                    "attrs": {
                      "level": 2
                    },
                    "content": [
                      {
                        "type": "text",
                        "text": "Contact"
                      }
                    ]
                  },
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "For privacy-related inquiries, use the contact form on this site."
                      }
                    ]
                  }
                ]
              }
