                    "position": 3,
                    "weight": 8,
                    "featured": true,
                    "content": {
                        "en": {
                            "label": "Safety First",
                            "description": "Every student deserves a safe, supportive environment. We maintain strict safeguarding policies and ensure every child is cared for on and off the platform."
                        },
