                {
                    "id": "33333333-0000-0000-0000-000000000114",
                    "type": "feature_item",
                    "position": 3,
                    "weight": 6,
                    "featured": false,
                    "content": {
                        "en": {
                            "label": "Academic Excellence",
                            "description": "We hold ourselves to the highest standard of educational quality, consistently supporting every student's potential."
                        },
                        "ar": {
                            "label": "التميز الأكاديمي",
                            "description": "نلتزم بأعلى معايير الجودة التعليمية، ونسعى باستمرار إلى دعم إمكانات كل طالب."
                        }
                    }
                },
                {
                    "id": "33333333-0000-0000-0000-000000000115",
                    "type": "feature_item",
                    "position": 4,
                    "weight": 6,
                    "featured": false,
                    "content": {
                        "en": {
                            "label": "Character & Integrity",
                            "description": "Learning is inseparable from values. We develop principled individuals who contribute positively to their communities."
                        },
                        "ar": {
                            "label": "الشخصية والنزاهة",
                            "description": "التعلم لا ينفصل عن القيم. نُعد أفراداً مبدئيين يُسهمون إيجابياً في مجتمعاتهم."
                        }
                    }
                },
                {
                    "id": "33333333-0000-0000-0000-000000000116",
                    "type": "feature_item",
                    "position": 5,
                    "weight": 6,
                    "featured": false,
                    "content": {
                        "en": {
                            "label": "Family Partnership",
                            "description": "Education works best when schools and families work together. We maintain open, transparent communication at every step."
                        },
                        "ar": {
                            "label": "الشراكة الأسرية",
                            "description": "يعمل التعليم بشكل أفضل عندما تتعاون المدارس والعائلات. نحرص على التواصل المفتوح والشفاف في كل خطوة."
                        }
                    }
                }
            ]
